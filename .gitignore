# Optional card-ID reference PDFs exceed GitHub's per-file limit. Keep local
# copies unchanged; the agent and bundle use the official CSV instead.
/data/official/*.pdf

# Output (replays are large; keep experiments JSON)
output/replays/

# The buddy native library remains ignored: kaggle-environments is the engine
# of record and supplies the platform-specific binary.
